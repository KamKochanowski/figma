{
  "name": "pulpit",
  "productName": "Pulpit",
  "version": "0.1.0",
  "private": true,
  "description": "Pulpit freelancera Kamila Kochanowskiego: współprace, zlecenia, kasa, poczta i dwa konta Claude w jednym oknie.",
  "author": "Kamil Kochanowski",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-strip-types \"tests/*.test.mts\"",
    "preview:web": "vite build --config vite.preview.config.ts",
    "dist": "electron-vite build && electron-builder --win",
    "mcp": "node ./out/main/mcp.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@anthropic-ai/sdk": "^0.93.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^4.0.3",
    "imapflow": "^2.9.0",
    "node-cron": "^4.2.1",
    "node-ical": "^0.27.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
